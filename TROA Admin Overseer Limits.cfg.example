<LimitsConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"><Enabled>false</Enabled><ScanIntervalSeconds>600</ScanIntervalSeconds><MaxAlertsPerScan>15</MaxAlertsPerScan><PlayerNearLimitPercent>80</PlayerNearLimitPercent><Limits><LimitRule><Name>Example limit - review before enabling</Name><Match>LargeBlockLargeThrust</Match><Scope>Player</Scope><Max>100</Max><Punishment>Alert</Punishment><GridKind>Any</GridKind><GridSize>Any</GridSize><WarningPercent>0</WarningPercent><ExemptRoles><string>admin</string><string>owner</string></ExemptRoles><ExemptSteamIds /></LimitRule></Limits></LimitsConfig>
